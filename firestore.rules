rules_version = '2';

// Cada usuário só lê e escreve o próprio documento de progresso, identificado
// pelo uid do Firebase Auth. Ninguém acessa o progresso de outra pessoa.
service cloud.firestore {
  match /databases/{database}/documents {
    match /progresso/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
