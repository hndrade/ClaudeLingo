# Copie para .env.local (que não vai pro git) e preencha com os valores do seu
# projeto Firebase: console.firebase.google.com > Configurações do projeto >
# Geral > Seus apps > app da Web > SDK setup and configuration.
# Não são segredos: identificam o projeto, não autorizam nada sozinhos.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
